[TEMPLATE]
APP_NAME="Joobjoob"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL — production MUST stay mysql, never sqlite) ────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joobjoob
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Admin Owner (used by AdminOwnerSeeder) ─────────────────────────
ADMIN_OWNER_NAME="Site Admin"
ADMIN_OWNER_EMAIL="admin@example.com"
ADMIN_OWNER_MOBILE="09123456789"
ADMIN_OWNER_PASSWORD=

# ── Kavenegar SMS ──────────────────────────────────────────────────
KAVENEGAR_BASE_URL="https://api.kavenegar.com/v1"
LOCAL_MOBILE=
SMS_TEST_NUMBER="09123456789"
OTP_TTL_MINUTES=2

# ── Uploads ────────────────────────────────────────────────────────
UPLOAD_PATH="uploads"

# ── Monitoring ────────────────────────────────────────────────────
MONITORING_ENABLED=true
MONITORING_STRICT=false          # true = log all requests, false = only slow (>1s)
MONITORING_LOG_PERFORMANCE=true
MONITORING_LOG_SMS=true
MONITORING_LOG_PAYMENTS=true
MONITORING_SLOW_THRESHOLD_MS=2000
MONITORING_VERY_SLOW_THRESHOLD_MS=5000

# ── ZarinPal Payment Gateway ─────────────────────────────────────────
# مرچنت‌کد ۳۶ کاراکتری از پنل زرین‌پال. مبالغ فروشگاه تومان‌اند و خودکار ×۱۰
# به ریال تبدیل می‌شوند (currency=IRR). برای تست: ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CURRENCY=IRR
ZARINPAL_SANDBOX_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

VITE_APP_NAME="${APP_NAME}"
