# ══════════════════════════════════════════════════════════════
# Shopora — Production Environment Template
# Generated for deployment on cPanel / DirectAdmin / Plesk
#
# Usage:
#   1. Copy this file to your server as .env
#   2. Fill in all values marked with ← change this
#   3. Run: php artisan key:generate --force
#   4. Run: php artisan config:cache
# ══════════════════════════════════════════════════════════════

APP_NAME="Shopora"
APP_ENV=production
APP_KEY=                          # ← filled by php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://shopora.ir        # ← change this

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # ← error only in production (not debug)

# ── Database (MySQL — NOT sqlite!) ──────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopora
DB_USERNAME=shopora_user
DB_PASSWORD=STRONG_PASSWORD_HERE  # ← change this

# ── Session / Cache / Queue ────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database         # ← or 'sync' for simplest V1 setup

FILESYSTEM_DISK=local
UPLOAD_PATH=uploads

# ── Mail (SMTP) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.host.com           # ← change this
MAIL_PORT=587
MAIL_USERNAME=noreply@shopora.ir  # ← change this
MAIL_PASSWORD=***                 # ← change this
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@shopora.ir"
MAIL_FROM_NAME="Shopora"

# ── Kavenegar SMS ──────────────────────────────────────────
KAVENEGAR_BASE_URL="https://api.kavenegar.com/v1"
LOCAL_MOBILE=
SMS_TEST_NUMBER=
OTP_TTL_MINUTES=2

# ── Chapar Shipping (disable in admin if not used) ─────────
CHAPAR_TOKEN=
CHAPAR_BASE_URL="http://api.krch.ir/v1/"

# ── Admin Owner (used by AdminOwnerSeeder) ─────────────────
ADMIN_OWNER_NAME="Site Admin"
ADMIN_OWNER_EMAIL="admin@shopora.ir"   # ← change this
ADMIN_OWNER_MOBILE="0912XXXXXXX"       # ← change this
ADMIN_OWNER_PASSWORD=STRONG_ADMIN_PASSWORD  # ← change this

# ── Vite ────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Redis (optional — uncomment if using Redis) ────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
